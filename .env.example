# ---- Base de datos ----
# SQLite (desarrollo local, por defecto)
DATABASE_URL="file:./dev.db"
# Postgres (produccion / Vercel). Descomenta y corre: npm run use:postgres
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ---- Seguridad ----
# Cambia esto por una cadena larga y aleatoria antes de publicar
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# ---- IA (opcional: tambien se pueden cargar desde Ajustes en la app) ----
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ---- Entrar con Google (opcional: tambien desde Ajustes) ----
# Se sacan de console.cloud.google.com creando un "ID de cliente de OAuth"
# de tipo Aplicacion web. La URI de redireccion que hay que registrar es:
#   https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
