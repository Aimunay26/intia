# ---- Base de datos ----
# El esquema y las consultas analíticas actuales usan PostgreSQL (también en local).
# En Vercel, conserva DATABASE_URL proporcionada por la integración de Neon.
DATABASE_URL="postgresql://user:pass@localhost:5432/marketing_os"

# ---- Seguridad ----
# Cambia esto por una cadena larga y aleatoria antes de publicar
AUTH_SECRET=""
# Generar cada clave independientemente: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Solo para el alta del primer dueño. Retirar una vez completada; jamás se muestra en logs.
BOOTSTRAP_TOKEN=""

# ---- IA (opcional: tambien se pueden cargar desde Ajustes en la app) ----
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# ---- Entrar con Google (opcional: tambien desde Ajustes) ----
# Se sacan de console.cloud.google.com creando un "ID de cliente de OAuth"
# de tipo Aplicacion web. La URI de redireccion que hay que registrar es:
#   https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Diagnóstico de navegación (apagado por defecto) ----
# Logs de fases/operaciones sin SQL ni datos. Añade ?medir=1 para medir el navegador.
PERFORMANCE_LOGS="0"
# Etiquetas opcionales para comparar mediciones del mismo entorno y versión.
# En Vercel se usan VERCEL_ENV y VERCEL_GIT_COMMIT_SHA automáticamente.
PERFORMANCE_ENVIRONMENT=""
PERFORMANCE_RELEASE=""
# Opcionales: dejarlos vacíos conserva el pool actual. Ajustar según mediciones/cuota.
DB_CONNECTION_LIMIT=""
DB_POOL_TIMEOUT_SECONDS=""
DB_CONNECT_TIMEOUT_SECONDS=""

# ---- Caché opcional de nombres de estructuras ----
# Solo para una organización por instalación. No cachea permisos ni sesiones.
# Mantener apagada hasta comparar el coste y validar el flujo en el despliegue.
CATALOG_CACHE_ENABLED="0"
# Nombre único por instalación y entorno. Si falta, se consulta la DB directamente.
CATALOG_CACHE_NAMESPACE=""

# ---- Panel: carga conjunta validada localmente; streaming permite revertir ----
PANEL_RENDER_MODE="together"

# ---- Trabajos de IA: activar después de migrar y validar Workflow en Vercel ----
# IA sin cupos internos de consumo. El proveedor aplica sus cuotas y facturación.
AI_JOBS_ENABLED="false"
AI_MAX_BATCH="3"
AI_MAX_OUTPUT_TOKENS="32000"
# Ventana de recuperación: el cron diario puede recuperar trabajos durante 72 h.
AI_JOB_MAX_AGE_HOURS="72"

# ---- Catálogo de productos por marca: activar después de migrar 20260928120000_brand_catalog ----
# Apagado (o sin valor), las marcas y el generador no consultan las tablas del catálogo.
PRODUCT_CATALOG_ENABLED="false"

# ---- Archivos privados: activar después de crear el almacén PRIVATE en iad1 ----
BLOB_PRIVATE_ENABLED="false"
BLOB_READ_WRITE_TOKEN=""
BLOB_STORAGE_LIMIT="800000000"
# Operaciones y transferencia: ventana móvil conservadora de 32 días.
BLOB_ADVANCED_LIMIT="1500"
BLOB_SIMPLE_LIMIT="8000"
BLOB_TRANSFER_LIMIT="8000000000"
# Tope de bytes de archivos guardados directamente en DB cuando Blob está apagado.
# Es una reserva de la aplicación, no el almacenamiento total ni la cuota del proveedor.
DB_ASSET_STORAGE_LIMIT="100000000"
# La retención técnica se configura en Ajustes, con vista previa. Apagada por defecto.
# El historial de negocio y los archivos vinculados no se purgan con esta política.
# Independiente de AUTH_SECRET; autentica únicamente el mantenimiento diario.
CRON_SECRET=""

# B22: independent AES-256 master keys, held outside DB/backups (32 random bytes as base64).
# Keep old versions here until all records are rotated and backup retention is resolved.
APP_SECRETS_KEYS=
APP_SECRETS_ACTIVE_KEY=
