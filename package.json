{
  "name": "alsos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/patch-next-react.mjs && prisma generate && next build && node scripts/verify-next-react-build.mjs",
    "start": "next start",
    "lint": "eslint src prisma scripts tests next.config.ts eslint.config.mjs",
    "db:push": "node scripts/local-database-only.mjs && prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/local-database-only.mjs && tsx prisma/seed.ts",
    "db:personas": "node scripts/local-database-only.mjs && tsx prisma/seed-personas-run.ts",
    "db:equipo-demo": "node scripts/local-database-only.mjs && tsx scripts/crear-equipo-demo.ts",
    "ver:prompt": "tsx scripts/ver-prompt.ts",
    "test:motores": "tsx scripts/calibrar-motor.ts",
    "db:reset": "node scripts/local-database-only.mjs && prisma migrate reset --force --skip-seed",
    "setup": "prisma generate && prisma migrate deploy",
    "use:postgres": "node scripts/switch-db.mjs postgresql",
    "use:sqlite": "node scripts/switch-db.mjs sqlite",
    "test:humo": "node scripts/smoke-test.mjs",
    "test:navegacion": "node --disable-warning=ExperimentalWarning --test tests/navigation.test.mjs tests/performance.test.mjs",
    "test:navegacion:postgres": "node --test tests/postgres-navigation.test.mjs",
    "test:seguridad": "node --test tests/security.test.mjs",
    "test:seguridad:postgres": "node --test tests/postgres-security.test.mjs",
    "test:demo:postgres": "node --test tests/postgres-demo.test.mjs",
    "test:seguridad:arranque": "node --test tests/security-startup.test.mjs",
    "test:cta": "tsx --test tests/cta-comunidad.test.mts",
    "test:presets": "tsx --test tests/presets-tipo.test.mts",
    "test:manual": "tsx --test tests/manual.test.mts tests/manual-scene-3d.test.mts tests/manual-characters.test.mts tests/manual-rig.test.mts",
    "test:manual-guias": "tsx --test tests/manual-guias.test.mts",
    "test:unidad": "node --disable-warning=ExperimentalWarning --test tests/navigation.test.mjs tests/performance.test.mjs tests/security.test.mjs tests/security-startup.test.mjs tests/consistency.test.mjs tests/permissions.test.mjs tests/archive-scope.test.mjs tests/gemini-models.test.mjs tests/generation-trace.test.mjs tests/ia-claves.test.mjs tests/branding-parser.test.mjs tests/content-structure-ids.test.mjs tests/backend-priorities.test.mjs tests/react-lazy-replay.test.mjs tests/workflow-policy.test.mjs tests/backend-completion.test.mjs tests/secrets-calendar.test.mjs tests/catalogo-productos.test.mjs tests/generador-producto.test.mjs tests/calendario.test.mjs tests/production-flow.test.mjs tests/production-chain.test.mjs tests/work-assignees.test.mjs tests/work-ui.test.mjs tests/guiones-visor.test.mjs tests/modelos-3d.test.mjs tests/equipo-tarjetas.test.mjs tests/role-panels.test.mjs tests/role-nav.test.mjs tests/role-lists.test.mjs tests/role-home.test.mjs && npm run test:cta && npm run test:presets && npm run test:manual && npm run test:manual-guias",
    "perf:resumen": "node scripts/summarize-navigation.mjs",
    "perf:db": "tsx scripts/diagnose-database.ts",
    "postinstall": "node scripts/patch-next-react.mjs && prisma generate",
    "guardia": "node scripts/proteger-produccion.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "node scripts/baseline-existing.mjs",
    "db:integridad": "node scripts/check-db-integrity.mjs",
    "test": "npm run test:unidad",
    "test:postgres": "node scripts/test-postgres.mjs",
    "db:ensayo": "node scripts/rehearse-migration.mjs",
    "perf:local": "node scripts/run-benchmark.mjs",
    "test:workflow": "node scripts/smoke-workflow.mjs",
    "test:perfiles": "node scripts/smoke-permissions.mjs",
    "perf:panel": "node scripts/benchmark-panel-ab.mjs",
    "assets:migrate": "tsx scripts/migrate-assets.ts",
    "secrets:migrate": "tsx scripts/migrate-secrets.ts",
    "datos:archivo": "tsx scripts/archivo-total.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@google/genai": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^6.7.0",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.460.0",
    "next": "15.5.24",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "unpdf": "^1.3.2",
    "workflow": "4.8.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.24",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "nanoid": "5.1.16",
    "undici": "7.29.0"
  }
}
